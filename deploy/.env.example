# ActiLens server settings
# Copy to deploy/.env (install-linux.sh does this automatically).

POSTGRES_USER=actilens
POSTGRES_DB=actilens
POSTGRES_PASSWORD=CHANGE_ME

# External HTTP port published by Docker.
ACTILENS_PORT=8081

# Bind address for the app port.
# LAN mode: 0.0.0.0
# HTTPS/Caddy mode: 127.0.0.1 (Caddy is the only public entry point)
ACTILENS_BIND_ADDR=0.0.0.0

# URL used by the web admin for same-origin/CORS configuration.
# For LAN: http://192.168.1.50:8081
# For production: https://tracking.example.com
PUBLIC_ORIGIN=http://localhost:8081

# Optional DNS name. Non-empty enables the Caddy HTTPS compose overlay in install-linux.sh/actilensctl.sh.
DOMAIN=

# Fast path: prebuilt image from GitHub Container Registry.
# install-linux.sh falls back to a local build if the image cannot be pulled.
ACTILENS_IMAGE=ghcr.io/0xdive/actilens:main
