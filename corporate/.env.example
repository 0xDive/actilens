# BiBoTracking Corporate server settings
# Copy to corporate/.env (install-linux.sh does this automatically).

POSTGRES_USER=ctracking
POSTGRES_DB=ctracking
POSTGRES_PASSWORD=CHANGE_ME

# External HTTP port published by Docker.
BIBO_PORT=8081

# URL used by the web admin for same-origin/CORS configuration.
# For LAN: http://192.168.1.50:8081
# For production: https://tracking.example.com
PUBLIC_ORIGIN=http://localhost:8081

# Fast path: prebuilt image from GitHub Container Registry.
# install-linux.sh falls back to a local build if the image cannot be pulled.
BIBO_IMAGE=ghcr.io/0xdive/emplooyee-tracking:main
